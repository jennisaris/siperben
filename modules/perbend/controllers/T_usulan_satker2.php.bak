					AND `isnonaktif` = '0' AND `itipe` = '0'";
			$result = $this->db->query($sql)->result();
			$no = 1;
			foreach($result as $r) {
				$html .= "<tr>";
				$html .= "<td>{$no}</td>";
				$html .= "<td>{$r->cnip}</td>";
				$html .= "<td>{$r->vname}</td>";
				$html .= "<td>{$r->jabatan_perbendaharan}</td";
				$html .= "</td>";

				$no++;
			}

			$html .= "</table>";
		} else $html .= "-";

		$html .= "</div>";

		return $html;
	}

