						<span style='cursor:pointer;' title = '{$alasan}' class='".($value == 0 ? 'label label-primary' : ($value == 1 ? 'label label-success' : 'label label-danger'))."'>".$status_daftar_pegawai[$value]."</span>
					   </div>";

		return $input;
	}

